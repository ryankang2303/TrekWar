{
  "expo": {
    "name": "Trekwar",
    "slug": "trekwar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.trekwar.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.trekwar.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-apple-authentication",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Trekwar uses your location to track distance during a walk or run session.",
          "locationAlwaysAndWhenInUsePermission": "Trekwar uses your location to keep recording your walk or run's distance if you lock your phone or switch apps mid-session.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Trekwar uses motion & fitness data to count your steps during a tracked session."
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Trekwar reads flights-climbed data from Health to power elevation-based races.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ],
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "898acbd7-e97d-44b6-af41-4d3427b9628a"
      }
    },
    "owner": "ryankang2303"
  }
}
